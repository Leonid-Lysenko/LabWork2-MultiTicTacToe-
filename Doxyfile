# Doxyfile 1.9.x

#---------------------------------------------------------------------------
# Project related configuration options
#---------------------------------------------------------------------------

# The PROJECT_NAME tag is a single word (or a sequence of words surrounded 
# by quotes) that should identify the project.
PROJECT_NAME           = "TicTacToe"

# The PROJECT_BRIEF tag can be used to specify a short description of the project.
PROJECT_BRIEF          = "Tic-Tac-Toe game with AI and 3D mode support"

# The PROJECT_LOGO tag can be used to specify a logo or an icon that is included in the documentation.
#PROJECT_LOGO           = 

# The OUTPUT_DIRECTORY tag is used to specify the (relative or absolute) path 
# into which the generated documentation will be written.
OUTPUT_DIRECTORY       = docs

# The CREATE_SUBDIRS tag can be used to have doxygen create subdirectories 
# for each output format.
CREATE_SUBDIRS         = NO

# The OUTPUT_LANGUAGE tag is used to specify the language in which all 
# documentation generated by doxygen is written.
OUTPUT_LANGUAGE        = English

# The FULL_PATH_NAMES tag can be used to specify whether doxygen should 
# include the full path before files in the file list and in the header files.
FULL_PATH_NAMES        = YES

# The STRIP_FROM_PATH tag can be used to strip a user-defined part of the path.
STRIP_FROM_PATH        = 

# The STRIP_FROM_INC_PATH tag can be used to strip a user-defined part of the path 
# for the include files.
STRIP_FROM_INC_PATH    = 

# The SHORT_NAMES tag can be used to generate shorter (but less readable) 
# file names.
SHORT_NAMES            = NO

# The JAVADOC_AUTOBRIEF tag can be used to interpret the first line of a JavaDoc 
# style comment as the brief description.
JAVADOC_AUTOBRIEF      = YES

# The MULTILINE_CPP_IS_BRIEF tag can be used to treat a multi-line C++ 
# comment block as a brief description.
MULTILINE_CPP_IS_BRIEF = NO

# The QT_AUTOBRIEF tag can be used to interpret the first line of a Qt-style 
# comment as the brief description.
QT_AUTOBRIEF           = NO

# The BUILTIN_STL_SUPPORT tag can be enabled to have doxygen generate better 
# documentation for STL containers.
BUILTIN_STL_SUPPORT    = YES

#---------------------------------------------------------------------------
# Build related configuration options
#---------------------------------------------------------------------------

# The EXTRACT_ALL tag can be used to enable extraction of all entities 
# in the source code, even if no documentation was provided.
EXTRACT_ALL            = YES

# The EXTRACT_PRIVATE tag can be used to enable extraction of private 
# class members.
EXTRACT_PRIVATE        = YES

# The EXTRACT_STATIC tag can be used to enable extraction of static members.
EXTRACT_STATIC         = YES

# The EXTRACT_LOCAL_CLASSES tag can be used to enable extraction of local classes.
EXTRACT_LOCAL_CLASSES  = YES

# The EXTRACT_ANON_NSPACES tag can be used to enable extraction of anonymous namespaces.
EXTRACT_ANON_NSPACES   = YES

# The EXTRACT_PACKAGE tag can be used to enable extraction of package level members.
EXTRACT_PACKAGE        = YES

# Disable warnings about documentation errors (e.g., duplicate @param)
WARN_IF_DOC_ERROR      = NO

#---------------------------------------------------------------------------
# Configuration options related to input files
#---------------------------------------------------------------------------

# The INPUT tag is used to specify the files and/or directories that contain 
# documented source files.
INPUT                  = include src tests README.md

# The FILE_PATTERNS tag can be used to specify patterns to filter the files 
# in the INPUT directories.
FILE_PATTERNS          = *.h *.hpp *.cpp *.c *.md

# If the RECURSIVE tag is set to YES, doxygen will recurse into subdirectories.
RECURSIVE              = YES

# The EXCLUDE tag can be used to specify files and/or directories that should be excluded.
EXCLUDE                = bin build

# The EXCLUDE_PATTERNS tag can be used to specify wildcard patterns to exclude certain files.
EXCLUDE_PATTERNS       = 

# The EXCLUDE_SYMBOLS tag can be used to specify symbols that should be excluded.
EXCLUDE_SYMBOLS        = 

#---------------------------------------------------------------------------
# Configuration options related to source browsing
#---------------------------------------------------------------------------

# If the SOURCE_BROWSER tag is set to YES, doxygen will generate source browser.
SOURCE_BROWSER         = YES

# If the INLINE_SOURCES tag is set to YES, doxygen will include the body of functions and classes in the documentation.
INLINE_SOURCES         = YES

#---------------------------------------------------------------------------
# Configuration options related to the HTML output
#---------------------------------------------------------------------------

# If the GENERATE_HTML tag is set to YES, doxygen will generate HTML output.
GENERATE_HTML          = YES

# The HTML_OUTPUT tag is used to specify the directory where the HTML docs will be put.
HTML_OUTPUT            = html

# The HTML_FILE_EXTENSION tag can be used to specify the file extension for HTML files.
HTML_FILE_EXTENSION    = .html

# The HTML_COLORSTYLE_HUE tag controls the color of the HTML output.
HTML_COLORSTYLE_HUE    = 220

# The HTML_COLORSTYLE_SAT tag controls the saturation of the HTML output.
HTML_COLORSTYLE_SAT    = 100

# The HTML_COLORSTYLE_GAMMA tag controls the gamma correction of the HTML output.
HTML_COLORSTYLE_GAMMA  = 80

# The HTML_TIMESTAMP tag can be used to enable timestamp in the footer.
HTML_TIMESTAMP         = YES

#---------------------------------------------------------------------------
# Configuration options related to LaTeX output
#---------------------------------------------------------------------------

GENERATE_LATEX         = NO

#---------------------------------------------------------------------------
# Configuration options related to the dot tool
#---------------------------------------------------------------------------

# If the HAVE_DOT tag is set to YES, doxygen will assume the dot tool is available.
HAVE_DOT               = YES

# If the CLASS_DIAGRAMS tag is set to YES, doxygen will generate class diagrams.
CLASS_DIAGRAMS         = YES

# If the CALL_GRAPH and CALLER_GRAPH tags are set to YES, doxygen will generate call and caller graphs.
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

# The DOT_IMAGE_FORMAT tag can be used to set the image format of the generated graphs.
DOT_IMAGE_FORMAT       = svg

#---------------------------------------------------------------------------
# Configuration options related to the search engine
#---------------------------------------------------------------------------

SEARCHENGINE           = YES
